{
  "name": "navikota",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NaviKota — A map-guide to Kota, the coaching city. Now an Android app via Capacitor.",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/leaflet": "^1.9.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
